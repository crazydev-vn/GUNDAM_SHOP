{
    "name": "gundam-shop",
    "version": "1.0.0",
    "description": "Website bán mô hình Gundam pre-order (đặt cọc, tích hợp MongoDB)",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
